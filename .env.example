# Zero-budget default. Install Ollama and pull qwen3:4b before AI planning.
COMPETITION_PROVIDER=ollama
COMPETITION_OLLAMA_URL=http://127.0.0.1:11434
COMPETITION_OLLAMA_MODEL=qwen3:4b
COMPETITION_ALLOWED_ORIGIN=http://127.0.0.1:5178
# Optional only for Ollama on Vite bound to 127.0.0.1; mandatory otherwise.
COMPETITION_ACCESS_TOKEN=

# Optional paid provider: change COMPETITION_PROVIDER to bedrock explicitly.
# Credentials use the AWS server-side credential chain; never use VITE_* secrets.
AWS_REGION=us-east-1
COMPETITION_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Nebius competition: opt in only after claiming free credits. Server-only key.
# Set COMPETITION_PROVIDER=nebius and a COMPETITION_ACCESS_TOKEN.
NEBIUS_API_KEY=
COMPETITION_NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# PayPal competition: sandbox only, server-only credentials.
PAYPAL_ALLOWED_ORIGIN=http://127.0.0.1:5179
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
